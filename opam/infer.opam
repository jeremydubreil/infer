opam-version: "2.0"
name: "infer"
version: "1.3.0"
synopsis: "A multi-language static analyzer"
maintainer: "the infer team"
authors: "Meta"
homepage: "https://github.com/facebook/infer"
bug-reports: "https://github.com/facebook/infer/issues"
dev-repo: "git://github.com/facebook/infer.git"
license: "MIT"
depends: [
  "ANSITerminal" {>="0.7"}
  "atdgen" {>="2.15.0"}
  "base64" {>="3.0.0"}
  "bheap"
  "cmdliner" {>="1.0.0"}
  "core" {>= "v0.17.1" & < "v0.18"}
  "conf-autoconf" {build}
  "conf-sqlite3" {build}
  "conf-zlib" {build}
  "charon"
  "containers" {>="3.15"}
  "containers-data" {>="3.15"}
  "ctypes" {>="0.9.2"}
  "dune" {build & >="3.6"}
  "fmt" {>="0.9.0"}
  "fpath" {>="0.7.3"}
  "iter"
  "javalib" {>="3.2.1"}
  "memtrace" {>="0.1.2"}
  "menhir" {>= "20220210"}
  "mtime" {>="2"}
  "ocaml" {>="5.4.1"}
  # No released ocamlfind works on native Windows with OCaml 5, so Windows needs the 1.9.9
  # preview. Every earlier version in opam-repository is ruled out:
  #   - 1.9.5 and older: "ocaml" {< "5.0"}, contradicting the `ocaml >= 5.4.1` above;
  #   - 1.9.6:           available: os != "win32";
  #   - 1.9.8:           "ocaml" {... & (os != "cygwin" & os-distribution != "msys2" | < "5.0") ...},
  #                      which collapses to `ocaml < 5.0` on msys2, and so also contradicts it.
  # 1.9.9~preview drops both the availability exclusion and the os-conditioned bound, because
  # findlib upstream fixed Windows between 1.9.8 and that snapshot -- it reworked the cygpath
  # handling and CR stripping in its configure script and added MSYS2 to its own CI.
  #
  # Constrained only on win32 so that Linux/macOS keep resolving exactly as they did before;
  # `>=` rather than `=` so a 1.9.9 or later release supersedes the preview automatically. Note
  # 1.9.9~preview carries `flags: avoid-version`, which is a soft solver preference, and it is
  # the only remaining candidate on Windows, so the solver still selects it.
  "ocamlfind" {build & (os != "win32" | >= "1.9.9~preview")}
  "ocamlgraph"
  "ounit" {>="2.0.5"}
  "parmap" {>="1.0-rc8"}
  "ppx_blob"
  "ppx_compare" {>= "v0.17" & < "v0.18"}
  "ppx_deriving" {>="4.1"}
  "ppx_enumerate" {>= "v0.17" & < "v0.18"}
  "ppx_expect" {>= "v0.17" & < "v0.18"}
  "ppx_fields_conv" {>= "v0.17" & < "v0.18"}
  "ppx_show"
  "ppx_yojson_conv" {>= "v0.17" & < "v0.18"}
  "pyml" {= "20220905"}
  "sawja" {>="1.5.11"}
  "saturn"
  "sedlex" {>="3.0"}
  "spawn" {>= "v0.17.0"}
  "sqlite3"
  "tdigest" {>="2.0.0"}
  "utop" {with-test}
  "xmlm" {>="1.2.0"}
  "yojson" {>="1.7.0"}
  "zarith" {>="1.7"}
]
build: [
  ["./autogen.sh"]
  ["./configure" "--prefix=%{prefix}%"]
  [make "-j" jobs]
  [make "-j" jobs "config_tests"] {with-test}
]
install: [make "install"]
depexts: [
  ["default-jdk"] {"ubuntu"}
  ["default-jdk"] {"debian"}
]
